{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MTG Pipeline GUI",
  "version": "0.1.0",
  "identifier": "com.mtgroles.pipelinegui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MTG Pipeline GUI",
        "width": 1200,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
