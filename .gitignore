# Ignore local CardConjurer source folder
/cardconjurer-master/

# Ignore generated PNGs in template subfolders, but keep .jpg output files
Cards/templates/Assassins/*
Cards/templates/Bandits/*
Cards/templates/Guardians/*
Cards/templates/Kings/*
Cards/templates/Renegades/*
Cards/templates/Output/*
!Cards/templates/Assassins/*.jpg
!Cards/templates/Bandits/*.jpg
!Cards/templates/Guardians/*.jpg
!Cards/templates/Kings/*.jpg
!Cards/templates/Renegades/*.jpg

# Node / Vite / Tauri build artifacts for Copilot/pipeline_gui
Copilot/pipeline_gui/node_modules/
Copilot/pipeline_gui/dist/
Copilot/pipeline_gui/src-tauri/target/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# Optional local env overrides
Copilot/pipeline_gui/.env
Copilot/pipeline_gui/.env.local

# Art generation config contains API token — keep out of git
# Copy art_gen_config.example.json -> art_gen_config.json and fill in your token
Copilot/cardconjurer_batch/art_gen_config.json

# Pipeline config files contain local paths/settings — keep out of git
# Copy *.example.json -> the matching .json and adjust to your setup
Copilot/cardconjurer_batch/generic_card_config.json
Copilot/cardconjurer_batch/Rolecard_Batch_Generator.config.json
Copilot/cardconjurer_batch/xml_export_config.json

# Optional Node/Vite cache and tooling artifacts
Copilot/pipeline_gui/.vite/
Copilot/pipeline_gui/.turbo/
Copilot/pipeline_gui/.eslintcache
Copilot/pipeline_gui/.cache/
